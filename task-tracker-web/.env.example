# API base URL, including the /api path. No secrets belong in this file.
# Vite inlines VITE_* variables at build time. A value already set in the
# environment (for example a Docker build ARG) wins over env files.
#
# Local dev (also the code default when this is unset):
# VITE_API_URL=http://localhost:8080/api
#
# Docker image / Render (nginx proxies /api on the same origin):
# VITE_API_URL=/api
